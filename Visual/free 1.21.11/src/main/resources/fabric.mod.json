{
  "schemaVersion": 1,
  "id": "lunacyvisuals",
  "version": "${version}",
  "name": "LunacyVisual Free",
  "description": "Free edition — limited visual suite for Minecraft ${minecraft_version}.",
  "authors": [
    "Lunacy"
  ],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "icon": "assets/lunacyvisuals/cosmic-logo.png",
  "entrypoints": {
    "client": [
      "net.lunacy.visuals.LunacyVisuals"
    ]
  },
  "mixins": [
    "lunacyvisuals.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
